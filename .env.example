# Copy to .env. `telegraph-miner init` will generate and append
# TELEGRAPH_EVM_PRIVATE_KEY here automatically if you don't set one.

TELEGRAPH_EVM_PRIVATE_KEY=
TELEGRAPH_NETWORK=base-sepolia

# Overrides — usually unnecessary, the defaults for TELEGRAPH_NETWORK cover them.
# TELEGRAPH_RPC_URL=
# TELEGRAPH_DIAMOND_ADDRESS=
# TELEGRAPH_NODE_URL=
# TELEGRAPH_WORKER_URL=
