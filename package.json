{
  "name": "telegraph-miner-plugin",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run build -w @telegraph/miner-core && npm run build -w @telegraph/miner-sdk -w telegraph-miner",
    "prepare": "npm run build",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0",
    "vitest": "^2.1.0"
  }
}
